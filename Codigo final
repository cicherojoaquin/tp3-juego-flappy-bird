class Pajaro:
    FOTOS = FOTOS_PAJAROS
    ROTACION_MAX = 25
    VEL_ROTACION = 20
    TIEMPO_ANIMADO = 5

    def __init__(self,x,y, genoma=None):
        self.x = x
        self.y = y #x,y posicion
        self.rotacion = 0 #angulo al dibujar, para que se incline al saltar y caer
        self.conteo = 0
        self.vel = 0
        self.height = self.y
        self.img_count = 0
        self.img = self.FOTOS[0]
        self.genoma = genoma #es el genoma, que decide cuando aletea y cuando no 
        self.vivo = True   #para saber cuando esta vivo y cuando no 
        self.tiempo_vivo = 0 # variable para saber cuanto lleva vivo

    def saltar(self): 
        self.vel = FLAP_STRENGTH #-10
        self.conteo = 0
        self.height = self.y 

    def move(self): #aplica la gravedad y va actualizando la posicion
        self.vel += GRAVITY      # +0.5 por frame
        self.y += self.vel

        if self.vel < 0 or self.y < self.height + 50:
            if self.rotacion < self.ROTACION_MAX:
                self.rotacion = self.ROTACION_MAX

        else:
            if self.rotacion > -90:
                self.rotacion -= self.VEL_ROTACION

    def dibujar(self,ventana): #le da la animacion al pajaro
        self.img_count += 1

        if self.img_count < self.TIEMPO_ANIMADO:
            self.img = self.FOTOS[0]
        elif self.img_count < self.TIEMPO_ANIMADO*2:
            self.img = self.FOTOS[1]
        elif self.img_count < self.TIEMPO_ANIMADO*3:
            self.img = self.FOTOS[2]
        elif self.img_count < self.TIEMPO_ANIMADO*4:
            self.img = self.FOTOS[1]
        elif self.img_count == self.TIEMPO_ANIMADO*4 +1:
            self.img = self.FOTOS[0]
            self.img_count = 0
        
        if self.rotacion <= -80:
            self.img = self.FOTOS[1]
            self.img_count = self.TIEMPO_ANIMADO*2
        
        imagen_rotada = pygame.transform.rotate(self.img, self.rotacion)
        forma_nueva = imagen_rotada.get_rect(center=self.img.get_rect(topleft = (self.x, self.y)).center)
        ventana.blit(imagen_rotada, forma_nueva.topleft)

    def get_mask(self): #genera el mask para la collision, 
        return pygame.mask.from_surface(self.img)

class Pipe:

    
    vel= PIPE_SPEED #seteo una variable para la velocidad en la que se mueven las tuberias para la derecha

    def __init__(self,x):
        self.x=x #posicion en x
        self.altura=0 #altura donde empieza el hueco entre las dos tuberias en la parte de arriba
        self.espacio = PIPE_GAP #espacio entre tuberias

        self.arriba=0 #donde la parte de arriba de la tuberia se va a dibujar
        self.abajo=0 #donde la parte de abajo de la tuberia se va a dibujar
        self.PIPE_arriba= pygame.transform.flip(FOTO_TUBO,False,True) #como la foto de la tuberia esta mirando para arriba, uso .flip() para darla vuelta y que la tuberia de arriba mire para abajo
        self.PIPE_abajo= FOTO_TUBO #en este caso la tuberia esta mirando para donden tiene que mirar, que es para arriba

        self.set_height() #define donde esta la parte de arriba y de abajo de la tuberia y que tan alto es
    
    def set_height(self):
        self.altura= random.randrange(50,450) #doy el rango de en que valores se puede encontrar la tuberia, es random
        self.arriba=self.altura - self.PIPE_arriba.get_height() #determina donde va a terminar la tuberia
        self.abajo= self.altura + self.espacio #donde se encuentra la parte de arriba y abajo
    
    def move(self):
        self.x-= self.vel #todo el tiempo que llamamos a este metodo, la tuberia se mueve para la izquierda
    
    def draw(self,ventana):
        ventana.blit(self.PIPE_arriba,(self.x,self.arriba)) 
        ventana.blit(self.PIPE_abajo,(self.x,self.abajo)) #dibuja las tuberias la parte de arriba y abajo
    
    def collide(self,pajaro):
        pajaro_mask = pajaro.get_mask() #el metodo get_mask() es como un metodo de get_rect pero mas preciso. Solo choca si efectivamente chocan los pixeles y no el hitbox
        arriba_mask = pygame.mask.from_surface(self.PIPE_arriba)
        abajo_mask = pygame.mask.from_surface(self.PIPE_abajo)
        
        #calculo que tan lejos estan estas mask entre si
        arriba_offset= (self.x-pajaro.x,self.arriba-round(pajaro.y))
        abajo_offset=(self.x-pajaro.x,self.abajo-round(pajaro.y))

        b_punto= pajaro_mask.overlap(abajo_mask, abajo_offset) #nos dice el punto de choque entre el pajaro y la tuberia de abajo, si no choca nos retorna None
        t_punto= pajaro_mask.overlap(arriba_mask, arriba_offset) #lo mismo que antes pero con la tuberia de arriba

        return bool(t_punto or b_punto) # retorna verdadero si b_punto o t_punto es algun valor y False si b_punto y t_punto es None

class Piso:
    vel = PIPE_SPEED #velocidad igual a la tuberia
    ancho = FOTO_PISO.get_width() #igual de ancho que la foto
    IMG = FOTO_PISO

    def __init__(self,y): 
        self.y = y
        self.x1 = 0
        self.x2 = self.ancho #posiciones de las dos imagenes que se van intercalando #self.x2 empieza cuando self.x1 termina (ancho es la cantidad de pixeles de ancho de la imagen del piso)
    
    def move(self):
        
        self.x1 -= self.vel 
        self.x2 -= self.vel #se mueve en sincronia con las tuberias

        if self.x1 + self.ancho <0:
            self.x1 = self.x2+self.ancho  
        
        if self.x2 + self.ancho <0:
            self.x2=self.x1+self.ancho #son basicamente dos imagenes y estos dos if lo que hace es que mueve estas dos bases de la misma forma sin dejar espacios, como si fuese solo una imagen.
            # cuando la primer imagen llega al final de la pantalla, mueve a la primer imagen hacia atras de la segunda, haciendo un ciclo en el que siempre hay un piso sin importar cuanto se avance
    
    def draw(self,ventana):  #dibuja el piso (como dijimos, son dos imagenes)
        ventana.blit(self.IMG, (self.x1,self.y))
        ventana.blit(self.IMG, (self.x2,self.y))


class GenomaPajaro: # Con esto se hace el genoma del pajaro 

    def __init__(self, pesos=None, rango_min=-1.0, rango_max=1.0):

        self.rango_min = rango_min # Va ser -1
        self.rango_max = rango_max # Va ser 1, representa el rango de los valores posibles de cada peso
        self.aptitud= 0.0 # No se define en el init ya que el pajaro no nace con aptitud sino que se calcula despues de jugar
        #aptitud es un valor de que tan bueno fue ese genoma
        
        if pesos is None:
            self.pesos= [] # Lista vacia que se la van sumando los pesos
            for i in range(6): # Itera 6 veces porque hay 6 genes (W0 hasta W5)
                numero_aleatorio= random.uniform(rango_min,rango_max) # Uniform elige desde el rango min al rango max con igual posibilidades
                self.pesos.append(numero_aleatorio)
        else:
            self.pesos=list(pesos)
    
    def aleteo_ia(self, cambio_y, cambio_x, velocidad_y): # Esto es como decide si aletear o no el pajaro, sin estimulacion externa (inteligente)
        
        w0, w1, w2, w3, w4, w5 = self.pesos # Desempaqueta los 6 "genes" que tiene el pajaro y son los que van a evolucionar
        
        #print(cambio_y)
        ny = cambio_y / 100     #  entre -1 y 1
        nx = cambio_x / 100  #  entre 0 y 1
        vy = velocidad_y / 100     #todo normalizado

        ny2 = ny * ny
        nx2 = nx * nx

        formula= (w0+ w1 * ny + w2 * ny2 + w3 * nx + w4 * nx2 + w5 * vy)
        return formula>0  # Si cumple, es TRUE y el pajaro aletea, sino es FALSE y el pajaro no aletea}
    
class Algoritmo_Gen:
    def __init__(self, poblacion=100, probabilad_mutacion=0.1, rango_min=-1.0, rango_max=1.0):
        self.tam_poblacion= poblacion 
        self.probabilidad_mutacion= probabilad_mutacion # Probabilad de que cada gen mute
        self.rango_min = rango_min
        self.rango_max = rango_max 
        self.poblacion=[] # Lista que guarda los genomas de cada uno de los 100 pajaros [genoma1, genoma2.... genoma100]
        self.generacion =0 # Esto va ser el contador de generaciones y empieza en 0}
        self.historial_fitness = [] #lista con el promedio fitness de cada generacion
    
    def poblacion_inicial(self): # Crea la primera poblacion, generacion 0
        self.poblacion=[]
        for i in range(self.tam_poblacion): # Itera la cantidad de veces que sea la poblacion del pajaro (100)
            genoma= GenomaPajaro(rango_min=self.rango_min, rango_max=self.rango_max) # Esto crea el genoma individual del pajaro con los valores minimos y maximos para cada gen (w)
            self.poblacion.append(genoma) # Agrega el genoma del pajaro a la lista de genomas 
        self.generacion=0
    
    def aptitud(self, lista_aptitudes): # Asigna la aptitud a cada genoma de la poblacion
        limite= min(len(self.poblacion), len(lista_aptitudes))
        for i in range(limite): # Recorre la lista de pajaros 1 por 1 y le otorga la aptitud correspondiente
            self.poblacion[i].aptitud = lista_aptitudes[i]

        if lista_aptitudes:
            promedio = sum(lista_aptitudes) / len(lista_aptitudes)  # PROMEDIO de tiempo_vivo
            self.historial_fitness.append(promedio) # agrega el resultado a la lista de self.historial__fitness

    def mas_aptos(self, n=10):
        ordenados= sorted(self.poblacion, key=lambda genoma: genoma.aptitud, reverse= True) # Ordena la poblacion de pajaros del mas apto al menos apto (reverse) usando
        
        return ordenados[:n] # Devuelve la lista de diez pajaros con los mejores genomas

    def cruzar_genomas(self, padre1, padre2):
        nuevos_pesos=[] # Lista donde se guardan los nuevos w de la siguiente generacion de pajaros 
        for w_padre1, w_padre2 in zip(padre1.pesos, padre2.pesos):
            if random.random() < 0.5: # Elige un numero entre 0 y 1, y dependiendo el valor, toma el valor w (gen) del padre correspondiente
                nuevos_pesos.append(w_padre1) 
            else:
                nuevos_pesos.append(w_padre2)

        return GenomaPajaro(pesos=nuevos_pesos, rango_min=self.rango_min, rango_max=self.rango_max) # Devuelve el pajaro 'hijo' con el genoma nuevo
    
    def nueva_generacion(self):
        mejores_10 = self.mas_aptos(n=10)
        nueva_poblacion = []
        
        # Generamos toda la nueva población a partir de cruces entre los mejores.
        while len(nueva_poblacion) < self.tam_poblacion:
            
            padre1, padre2= random.sample(mejores_10,2) #selecciona los dos padres conl os que se va a crear el hijo de forma aleatoria entre la lista de los mejores 10 pajaros



            hijo = self.cruzar_genomas(padre1, padre2)  # Genera el hijo usando posibles genes de los padres
            self.mutacion_del_genoma(hijo)  # Le aplica la posible mutacion al hijo

            nueva_poblacion.append(hijo)  # Agrega hijos hasta que el numero de pajaros llegue a 100


        self.poblacion = nueva_poblacion  # reemplaza la poblacion anterior por la nueva
        self.generacion += 1  # Se suma uno al contador de generaciones

    
    def mutacion_del_genoma(self, genoma):
        for i in range(len(genoma.pesos)):
            if random.random() < self.probabilidad_mutacion: # Elige un valor entre 0.0 y 1.0, y si es menor a la prob de mutacion, muta el gen
                cambio= random.uniform(self.rango_min, self.rango_max) # El gen muta y es cualquier valor entre los rangos de w posibles
                genoma.pesos[i]=cambio

def crear_pajaros_desde_genomas(lista_genomas):
    "Esta funcion crea los pajaros con las condiciones anteriores"
    pajaros = []
    for genoma in lista_genomas:
        pajaros.append(Pajaro(230, 350, genoma=genoma))

    return pajaros

def dibujar_panel(ventana, algoritmo, vivos, tiempo_actual):
    #Fondo del panel
    pygame.draw.rect(ventana, (50, 50, 50), (WIN_WIDTH, 0, PANEL_WIDTH, WIN_HEIGHT)) #el fondo
    pygame.draw.line(ventana, (255, 255, 255), (WIN_WIDTH, 0), (WIN_WIDTH, WIN_HEIGHT), 2) #la linea que separa el panel con el juego
    
    # Coordenadas base
    x_base = WIN_WIDTH + 15
    y_base = 20

    # Textos Estadísticos
    # Titulo
    t_obj = PANEL_FONT.render("Estadísticas GA", True, (255, 255, 255))
    ventana.blit(t_obj, (x_base, y_base))
    
    mejor = 0
    if algoritmo.historial_fitness:
        mejor = max(algoritmo.historial_fitness)/FPS

    info = [
        f"Generacion: {algoritmo.generacion}",
        f"Vivos: {vivos} / {algoritmo.tam_poblacion}",
        f"Tiempo: {tiempo_actual:.1f}s",
        f"Mejor promedio en tiempo de vida: {mejor:.1f}s"
    ]

    for i, texto in enumerate(info):
        t_obj = PANEL_FONT.render(texto, True, (200, 200, 200))
        ventana.blit(t_obj, (x_base, y_base + 40 + (i * 30)))

    # Gráfico de Progreso
    y_grafico = 300
    alto_grafico = 200
    ancho_grafico = PANEL_WIDTH - 30
    
    # TÍTULO DEL GRÁFICO 
    titulo_graf = PANEL_FONT.render("Progreso fitness:", True, (255, 255, 255))
    ventana.blit(titulo_graf, (x_base, y_grafico - 25))

    # Caja para el gráfico
    rect_grafico = pygame.Rect(x_base, y_grafico, ancho_grafico, alto_grafico)
    pygame.draw.rect(ventana, (20, 20, 20), rect_grafico)
    pygame.draw.rect(ventana, (255, 255, 255), rect_grafico, 1)
    
    # Dibujar línea
    historial = algoritmo.historial_fitness
    if len(historial) >= 1:#cuando comienza a tener valores la lista de historial
        max_fit = max(historial)
        if max_fit == 0: max_fit = 1
        
        puntos = []
        for i, fit in enumerate(historial): #i es el numero de la generacion, fit es el fitness promedio de esa generacion
            x_punto = x_base + (i / len(historial)) * ancho_grafico #divide el ancho del grafico en tantas partes como generaciones haya. la generacion i=0 va quedando a la izquierda y la ultima generacion a la derecha
            y_punto = (y_grafico + alto_grafico) - (fit / max_fit) * alto_grafico #como la y crece hacia abajo (y_grafico + alto_grafico) es la parte de abajo de la caja.
            #(fit/max_fit) devuelve un numero entre 0 y 1, si fit es el maximo el punto se dibuja arriba de todo
            puntos.append((x_punto, y_punto)) #se van guardando todos los puntos
        
        if len(puntos) >= 2:
            pygame.draw.lines(ventana, (0, 255, 0), False, puntos, 2) #dibuja una linea verde que conecta los puntos

def main():
    
    ventana = pygame.display.set_mode((WIN_WIDTH + PANEL_WIDTH, WIN_HEIGHT))
    tiempo= pygame.time.Clock()
    


    algoritmo= Algoritmo_Gen() # Crea el algoritmo genetico 
    algoritmo.poblacion_inicial()

    NUM_GENERACIONES = 100 #cuantas generaciones simular

    speed_mult = 1  # velocidad en x1 al inicio 
    boton_rect = pygame.Rect(WIN_WIDTH - 110, 10, 100, 30)  # crea un boton arriba a la derecha del juego que tocas y la velocidad aumenta a x2


    for numero_generacion in range(NUM_GENERACIONES):  #para cada generacion:..
        print(f"Empieza generacion {numero_generacion}")

        piso= Piso(730) #730 = coordenada vertical, setea el piso abajo de todo
        pipes= [Pipe(700)] #donde se encuentra el piso y la tuberia, posiciones iniciales. 
    
        pajaros= crear_pajaros_desde_genomas(algoritmo.poblacion) #crea los pajaros con sus genomas

        generacion_terminada = False # Esto corta el while del juego 
        frames_generacion = 0 #reseta el tiempo de la generacion
        MAX_FRAMES = MAX_TIME * FPS

    # Empiza el bucle de juego para la generacion que toque

        while not generacion_terminada:
            tiempo.tick(FPS) #los fps seteados
            

            for event in pygame.event.get():
                if event.type == pygame.QUIT: #si se cierra la ventana, se cierra el juego
                    pygame.quit()
                    quit()
                elif event.type == pygame.MOUSEBUTTONDOWN: #esto detecta un click
                    if boton_rect.collidepoint(event.pos): #chequea si ese click se hizo en el boton para cambiar las velocidades
                        # cambia entre x1 y x2
                        if speed_mult == 1: # pasa de x1 a x2 y de x2 a x1 con cada click
                            speed_mult = 2
                        else:
                            speed_mult = 1

       
        
            #se ejecuta speed_mult veces por frame, si esta en x1 es en x1 y si speed_mult esta en x2 se ejecuta dos veces por frame
            for _ in range(speed_mult):
                frames_generacion += 1 #va sumando frames a medida que la generacion va sobreviviendo (luego se convierte a tiempo mas abajo)

                pipe_obj = pipes[0] #como solo usa una tuberia a la vez, tomo la primer tuberia de la lista para ser la que calcula la distancia
                vivos = 0
                
                for pajaro in pajaros:
                    if not pajaro.vivo: # si el pajaro ya murio lo salteo
                        continue

                    vivos += 1 #cuenta cuantos siguen vivos 

                    cambio_y = pipe_obj.altura - pajaro.y
                    cambio_x = pipe_obj.x - pajaro.x
                    velocidad_y = pajaro.vel #describen la posicion del pajaro y la velocidad

                    if pajaro.genoma.aleteo_ia(cambio_y, cambio_x, velocidad_y): #si se cumple la condicion de salto, el pajaro salta
                        pajaro.saltar()
                        SONIDO_SALTO.play()
                    
                    pajaro.move() #convoca la funcion move y los pajaros se mueven
                    pajaro.tiempo_vivo += 1 #suma al contador individual de tiempo de vida

                    # Posibles muertes de pajaros
                    if pajaro.y + pajaro.img.get_height() >= 730: #si choca contra el piso:
                        pajaro.vivo = False
                    elif pajaro.y < 0: #si pasa el techo:
                        pajaro.vivo = False
                    elif pipe_obj.collide(pajaro): # si choca contra la tuberia:
                        pajaro.vivo = False 
            
                # Movimiento de tuberias 
                for pipe in pipes:
                    pipe.move() #mueve la tuberia a la izquierda
                    if pipe.x + pipe.PIPE_arriba.get_width() < 0: #si la tuberia salio totalmente de la pantalla:
                        pipe.x = 700 #vuelve a la derecha (reciclo la tuberia)
                        pipe.set_height() # le da una nueva altura random

                piso.move() #muevo el piso a la izquierda a la misma velocidad que esten las pipes (si es x1 o x2)

                if vivos == 0 or frames_generacion >= MAX_FRAMES: #si esto es asi, se corta la generacion
                    generacion_terminada = True
                    break  # salimos del for _ si ya terminó la generación

            #DIBUJOS
            ventana.blit(FOTO_FONDO, (0, 0))

            for pipe in pipes:
                pipe.draw(ventana)

            piso.draw(ventana)

            for pajaro in pajaros:
                if pajaro.vivo:
                    pajaro.dibujar(ventana)

            # DIBUJAR BOTÓN DE VELOCIDAD
            color_boton = (200, 200, 200) if speed_mult == 1 else (255, 215, 0) #color gris si esta en por uno y color amarillo si esta en x2
            pygame.draw.rect(ventana, color_boton, boton_rect)
            etiqueta = PANEL_FONT.render(f"x{speed_mult}", True, (0, 0, 0))
            ventana.blit(etiqueta, (boton_rect.x + 35, boton_rect.y + 5))

            # Panel derecho
            tiempo_segundos = frames_generacion / FPS #cambia la medicion de tiempo de vida de frames a segundos
            dibujar_panel(ventana, algoritmo, vivos, tiempo_segundos) #muestra el panel

            pygame.display.update() #actualiza la pantalla
             
    # Calculo de aptitudes cuando mueren los pajaros y la evolucion

        lista_aptitudes= [p.tiempo_vivo for p in pajaros] #junta los tiempos vivos de todos los pajaros en la generacion
        algoritmo.aptitud(lista_aptitudes)
        algoritmo.nueva_generacion()

        # Cuando termina
    pygame.quit()

if __name__ == "__main__":
    main()
