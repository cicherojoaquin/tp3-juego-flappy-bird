    piso = Piso(730)
    pipes = [Pipe(700)]
    score = 0
    return pajaro, piso, pipes, score  # <<< devuelve nuevos objetos !!!

def crear_pajaros_desde_genomas(lista_genomas):
    "Esta funcion crea los pajaros con las condiciones anteriores"
    pajaros = []
    for genoma in lista_genomas:
        pajaro = Pajaro(230, 350, genoma=genoma)
        pajaros.append(pajaro)
    return pajaros

def main():
    
