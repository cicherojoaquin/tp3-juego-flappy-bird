    algoritmo.poblacion_inicial()

    pajaros = crear_pajaros_desde_genomas(algoritmo.poblacion) # Crea los 100 pajaros fisicos desde los genomas

    pygame.mixer.music.play(-1)  # vuelve a arrancar la música de fondo !!!


    # Hace que haya un maximo de 6 generaciones y corran las 6 

    for numero_generacion in range(6):
        print(f"Empieza generacion {numero_generacion}")

        piso= Piso(730)
        pipes= [Pipe(700)]

        # Crea los 100 pajaros desde los genomas que toquen actuales

        pajaros= crear_pajaros_desde_genomas(algoritmo.poblacion)

        generacion_terminada = False # Esto corta el while del juego 


    # Empiza el bucle de juego para la generacion que toque
        while not generacion_terminada:
            tiempo.tick(40) #fija a 40 fps
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    quit()

      #  Tuberia para que los pajaros decidan si aletear o no       
        
            pipe_obj = None
