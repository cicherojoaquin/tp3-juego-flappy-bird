                    pipe_obj = pipe
                    break
    
    # Recorre los 100 pajaros y va contando cuantos quedan vivos

            vivos=0
            for pajaro in pajaros:
                if pajaro.vivo:
                    vivos+=1

                # Para la IA ahora 

                cambio_y= pipe_obj.altura - pajaro.y
                cambio_x= pipe_obj.x - pajaro.x
                velocidad_y= pajaro.vel

                if pajaro.genoma.aleteo_ia(cambio_y,cambio_x, velocidad_y):
                    pajaro.saltar()
                    SONIDO_SALTO.play()

                # Mueve y suma tiempo vivo del pajaro
                pajaro.move()
                pajaro.tiempo_vivo +=1

                # Ahora chequeamos si muere

                if pajaro.y + pajaro.img.get_height() >= 730: # Si choca con el piso
                    pajaro.vivo= False
                if pajaro.y < 0: # Si choca con el techo
                    pajaro.vivo= False
                if pipe_obj.collide(pajaro): # Si choca con tuberia
                    pajaro.vivo= False
                
            if vivos==0:
                    generacion_terminada=True

            # Movimiento de tuberia

            add_pipe=False
            sacar= []
            for pipe in pipes:
                pipe.move()
            
            if pipe.x+pipe.PIPE_arriba.get_width() < 0:
                sacar.append(pipe)
            
            if not pipe.passed and pipe.x < 230: #chequea si el pajaro ya paso la tuberia
                pipe.passed=True
                add_pipe=True

            if add_pipe:
                pipes.append(Pipe(700))

            for el in sacar:
                pipes.remove(el)  #Elimina las tuberias que ya pasaron

            # Dibujo de todo 

